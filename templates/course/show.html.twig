{% extends 'base.html.twig' %}

{% block title %}{{ course.title }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>{{ course.title }}</h1>
    <div>
        <a href="{{ path('app_course_edit', {'id': course.id}) }}" class="btn btn-outline-primary">Modifier</a>
        {{ include('course/_delete_form.html.twig') }}
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">{{ course.description ?: '—' }}</dd>

            <dt class="col-sm-3">Date de début</dt>
            <dd class="col-sm-9">{{ course.startDate ? course.startDate|date('d/m/Y') : '—' }}</dd>
        </dl>
    </div>
</div>

<h2 class="h4 mb-3">Étudiants inscrits</h2>

{% if course.students|length > 0 %}
    <ul class="list-group mb-4">
        {% for student in course.students %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                {{ student.firstName }} {{ student.lastName }}
                <a href="{{ path('app_student_show', {'id': student.id}) }}" class="btn btn-sm btn-outline-secondary">Voir l'étudiant</a>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p class="text-muted">Aucun étudiant inscrit à ce cours.</p>
{% endif %}

<a href="{{ path('app_course_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
{% endblock %}