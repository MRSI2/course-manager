{% extends 'base.html.twig' %}

{% block title %}{{ student.firstName }} {{ student.lastName }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>{{ student.firstName }} {{ student.lastName }}</h1>
    <div>
        <a href="{{ path('app_student_edit', {'id': student.id}) }}" class="btn btn-outline-primary">Modifier</a>
        {{ include('student/_delete_form.html.twig') }}
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">{{ student.email }}</dd>

            <dt class="col-sm-3">Date d'inscription</dt>
            <dd class="col-sm-9">{{ student.enrollmentDate ? student.enrollmentDate|date('d/m/Y') : '—' }}</dd>
        </dl>
    </div>
</div>

<h2 class="h4 mb-3">Cours suivis</h2>

{% if student.courses|length > 0 %}
    <ul class="list-group mb-4">
        {% for course in student.courses %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                {{ course.title }}
                <a href="{{ path('app_course_show', {'id': course.id}) }}" class="btn btn-sm btn-outline-secondary">Voir le cours</a>
            </li>
        {% endfor %}
    </ul>
{% else %}
    <p class="text-muted">Cet étudiant n'est inscrit à aucun cours.</p>
{% endif %}

<a href="{{ path('app_student_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
{% endblock %}