{% extends 'base.html.twig' %}

{% block title %}Étudiants{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Étudiants</h1>
    <a href="{{ path('app_student_new') }}" class="btn btn-primary">+ Ajouter un étudiant</a>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle bg-white shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Date d'inscription</th>
                <th>Cours suivis</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for student in students %}
            <tr>
                <td>{{ student.firstName }} {{ student.lastName }}</td>
                <td>{{ student.email }}</td>
                <td>{{ student.enrollmentDate ? student.enrollmentDate|date('d/m/Y') : '' }}</td>
                <td>
                    {% if student.courses|length > 0 %}
                        <span class="badge bg-secondary">{{ student.courses|length }}</span>
                    {% else %}
                        <span class="text-muted">Aucun</span>
                    {% endif %}
                </td>
                <td class="text-end">
                    <a href="{{ path('app_student_show', {'id': student.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                    <a href="{{ path('app_student_edit', {'id': student.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center text-muted py-4">Aucun étudiant pour l'instant.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}