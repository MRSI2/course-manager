{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div class="text-center mb-5">
    <h1 class="display-5 fw-bold">🎓 Course Manager</h1>
    <p class="text-muted">Plateforme de gestion de cours et d'étudiants</p>
</div>

<div class="row justify-content-center g-4">
    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h2 class="display-4">{{ studentCount }}</h2>
                <p class="text-muted mb-3">Étudiant{{ studentCount > 1 ? 's' : '' }} inscrit{{ studentCount > 1 ? 's' : '' }}</p>
                <a href="{{ path('app_student_index') }}" class="btn btn-primary">Voir les étudiants</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h2 class="display-4">{{ courseCount }}</h2>
                <p class="text-muted mb-3">Cours disponible{{ courseCount > 1 ? 's' : '' }}</p>
                <a href="{{ path('app_course_index') }}" class="btn btn-primary">Voir les cours</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}